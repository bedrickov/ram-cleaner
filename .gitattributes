# Auto-detect text files and normalize line endings
* text=auto

# Source code files with CRLF (Windows WPF / Win32)
*.cs text eol=crlf
*.xaml text eol=crlf
*.xml text eol=crlf
*.manifest text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.slnx text eol=crlf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.exe binary
*.dll binary
*.ico binary
*.png binary
*.jpg binary
